# Скопируйте этот файл в .env и вставьте значения из предыдущего проекта.
# .env в репозиторий не попадает.

# Telegram, токен из BotFather
TELEGRAM_BOT_TOKEN=

# OpenAI через proxyapi.ru. Адрес общий для эмбеддингов и генерации.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=
EMBEDDING_MODEL=
# Размерность должна совпадать с уже созданным индексом Pinecone.
EMBEDDING_DIM=

# Тот же индекс, что в прошлом проекте. Данные этого бота лежат в отдельном namespace.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=
